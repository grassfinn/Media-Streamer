doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    link(rel="icon", type="image/svg+xml", href="/favicon.svg")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title media-streamer
    link(rel="stylesheet", href="./css/style.css")
  
  body
    header
      nav
        ul.nav-flex
          li
            a(href="./index.html").logo
              img(src="./image/logo.png", alt="Beaver").logo
              span.logo B.E.A.V.A.R.
          li
            form#nav-form(action="")
              select(name="content")
                option(disabled, selected, value="lectures") Content
                option(value="videos") Videos
                option(value="lectures") Lectures
                option(value="podcasts") Podcasts
              input(type="text", placeholder="Search", name="search", autocomplete="off")
          li
            div
              a(href="#") 📺
              a(href="#") 📻
              a(href="#") 🎶
              a(href="#") 📚

    section#search-results
    main
      // Search Results

      // Recent Videos
      section.video-content
        article.video 
          h3 Recent Video 
          div.flex
            h4.recent-media 
            video(controls, width="400").recent-vid
              source(src=locations.videoSrc, type="video/mp4;")
        article.lecture 
            h3 Recent Lecture
            div.flex 
              h4.recent-media 
              video(controls, width="400").recent-lecture
                  source(src=locations.lectureSrc, type="video/mp4")

      // Recent Podcasts
      section.audio-content
        h2 Recent Podcasts
        div
          h3.recent-media
          audio(controls)
            source(src=locations.podcastSrc, type="audio/mpeg")
        div
          details
            summary Previous podcasts
            ul
              li 1
              li 2
              li 3

    script(type="module", src="./js/app.js")